# --- PlusOne agent configuration ---
# Copy to .env and fill in. This file holds NO real secrets.
# .env is gitignored; never commit real keys.

# Provider selection (fixture adapters need no credentials)
#
# LLM (the planner/compiler):
#   fixture   deterministic canned plan, offline, free (the default)
#   groq      openai/gpt-oss-120b on Groq's free tier (needs AGENT_LLM_API_KEY)
# Aliases: gpt-oss, gptoss, oss
#
# Vision (reference analysis + venue photo reading):
#   fixture   offline canned analysis, free (the default)
#   nemotron  NVIDIA Nemotron VL via NIM (needs AGENT_VISION_API_KEY)
# Aliases: nvidia, nvidia-vl, nim
#
# Image providers:
#   fixture      offline synthetic PNGs, free
#   nvidia       Black Forest Labs via NVIDIA NIM (needs AGENT_NVIDIA_API_KEY)
#   huggingface  local diffusers on your own GPU, free (Colab-friendly)
#   qwen         alias for huggingface + Qwen/Qwen-Image-Edit-2509 (identity!)
#   gemini | openai | fal
# Aliases: google, flux, hf, local, colab, flux-local, sd, nim, bfl
#
# Web: see "Web research" below.
AGENT_LLM_PROVIDER=fixture
AGENT_VISION_PROVIDER=fixture
AGENT_IMAGE_PROVIDER=fixture
AGENT_WEB_PROVIDER=fixture
# The whole real switch is the four names below plus the keys. Check what the
# environment actually selects (and what it still needs) with:
#   python -m pigamagic_agent.agent.cli providers
# AGENT_LLM_PROVIDER=groq            # openai/gpt-oss-120b
# AGENT_VISION_PROVIDER=nemotron     # nvidia/nemotron-nano-12b-v2-vl
# AGENT_IMAGE_PROVIDER=nvidia        # flux-3-image-klein (text-to-image only)
# AGENT_WEB_PROVIDER=duckduckgo      # keyless; or serper with AGENT_SERPER_API_KEY

# Credentials (leave blank while using fixtures)
# One NVIDIA key covers both the vision adapter and the image adapter; each can
# also be given its own key. Groq's key can be set as AGENT_LLM_API_KEY or as
# AGENT_GROQ_API_KEY.
AGENT_LLM_API_KEY=
AGENT_VISION_API_KEY=
AGENT_IMAGE_API_KEY=
AGENT_WEB_API_KEY=
AGENT_NVIDIA_API_KEY=
AGENT_GROQ_API_KEY=
AGENT_SERPER_API_KEY=

# --- Web research (venue lookups, design.md 6.1) -----------------------------
# Web providers:
#   fixture     offline canned corpus, deterministic, free (the default)
#   duckduckgo  keyless open web via DuckDuckGo Lite; no account, no key
#   wikipedia   keyless public API; real venue facts for notable places
#   searxng     keyless open web via your own instance (needs AGENT_WEB_BASE_URL)
#   serper      Google results as JSON; needs AGENT_WEB_API_KEY (~$0.001/query)
#   brave       open web, clean JSON; needs AGENT_WEB_API_KEY
# Aliases: ddg, duck-duck-go, wiki, searx, brave-search, offline
#
# DuckDuckGo needs nothing at all, so it is the quickest way to real venues --
# but it is an undocumented endpoint and it rate-limits: when it shows a bot
# challenge the adapter raises a retryable error instead of pretending the venue
# has no web presence. Serper is the reliable paid option if a shoot must not
# fail on search.
#
# Wikipedia is the recommended first real provider: no key, no account, and it
# describes architecture and grounds in exactly the vocabulary the planner
# needs. A venue with no article returns no evidence (low confidence) rather
# than invented detail, which is the intended behaviour.
#
# SearXNG: `format=json` must be enabled on the instance
# (`search.formats: [html, json]` in settings.yml), otherwise it answers with an
# HTML page and the adapter tells you so.
#
# Brave: free monthly quota, then ~$5 per 1000 queries. The spend is reported to
# the budget ledger; AGENT_MAX_SEARCH_CALLS caps the number of searches.
AGENT_WEB_BASE_URL=

# Model identifiers (blank = the provider's pinned current default)
# groq        -> openai/gpt-oss-120b
# nemotron    -> nvidia/nemotron-nano-12b-v2-vl
# gemini      -> gemini-3.1-flash-image
# openai      -> gpt-image-2.5-flare
# fal         -> blackforestlabs/flux-3/text-to-image
# nvidia      -> flux-3-image-klein   (hyphenated: the documented NIM slug)
# huggingface -> Qwen/Qwen-Image-2.1-Turbo  (ungated, 8 steps, takes refs)
#   other local options:
#     Qwen/Qwen-Image-Edit-2509        keeps facial identity, up to 3 refs
#     black-forest-labs/FLUX.1-Kontext-dev   gated, needs an HF token
AGENT_LLM_MODEL=
AGENT_VISION_MODEL=
AGENT_IMAGE_MODEL=

# Prompt versioning. Bumping this deliberately invalidates the prompt cache.
AGENT_PROMPT_VERSION=v1

# Budgets and limits
AGENT_MAX_SHOTS=16
AGENT_MAX_SEARCH_CALLS=6
AGENT_MAX_REFERENCE_NOTES_TOKENS=300
AGENT_IDENTITY_SIMILARITY_FLOOR=0.45
AGENT_IDENTITY_SIMILARITY_TARGET=0.62

# Real-spend ceiling for image generation, in USD. 0 = unlimited (fixtures only).
# A positive value makes the budget ledger REFUSE any call that would exceed it.
AGENT_IMAGE_BUDGET_USD=0

# Outbound provider reliability
AGENT_PROVIDER_MAX_ATTEMPTS=3
AGENT_PROVIDER_TIMEOUT_S=120

# Set to 1 to forbid ALL outbound HTTP. Tests and CI must stay offline.
AGENT_OFFLINE=false

# --- NVIDIA NIM (Black Forest Labs) -------------------------------------
# Get a key at https://build.nvidia.com  ->  your profile -> API Keys.
# Either this or AGENT_IMAGE_API_KEY works; this one wins if both are blank
# elsewhere. Only needed when AGENT_IMAGE_PROVIDER=nvidia.
AGENT_NVIDIA_API_KEY=
# Optional override; defaults to the hosted endpoint.
AGENT_NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs
# Set true ONLY when pointing at your own NIM container. This changes the host
# only: the adapter is text-to-image and never uploads a reference image.
AGENT_NVIDIA_NIM_SELF_HOSTED=false

# Storage
# local | s3 | backblaze  (s3 and backblaze share every setting below)
AGENT_STORAGE_PROVIDER=local
# Relative paths land on the C: drive, which is nearly full. Use an absolute
# path on a roomy drive; D:/pigamagic-media/agent is the local default here.
AGENT_MEDIA_DIR=D:/pigamagic-media/agent
# Optional: prefix URLs for the local store, e.g. http://localhost:8000/media
AGENT_MEDIA_BASE_URL=

# S3-compatible object storage.
# Backblaze B2: set AGENT_STORAGE_PROVIDER=backblaze, put the bucket's region
# (e.g. us-west-004) in AGENT_STORAGE_REGION, use the APPLICATION KEY ID as the
# access key id and the APPLICATION KEY as the secret. The B2 master key does
# not work with the S3 API. Leave AGENT_STORAGE_ENDPOINT blank and the endpoint
# is derived as https://s3.<region>.backblazeb2.com.
# Cloudflare R2 / MinIO / Wasabi: set AGENT_STORAGE_PROVIDER=s3 and fill in
# AGENT_STORAGE_ENDPOINT yourself.
AGENT_STORAGE_BUCKET=
AGENT_STORAGE_ENDPOINT=
AGENT_STORAGE_REGION=
AGENT_STORAGE_ACCESS_KEY_ID=
AGENT_STORAGE_SECRET_ACCESS_KEY=
# Key prefix inside the bucket, so several apps can share one bucket.
AGENT_STORAGE_PREFIX=plusone
# Public/CDN base for read URLs. Blank serves through the app.
AGENT_STORAGE_PUBLIC_BASE_URL=

# --- Admin surface -----------------------------------------------------------
# Shared secret for /api/v1/admin/* (safety review console, account purge).
# Sent as the `X-Admin-Token` header.
#
# Leave this BLANK to disable the admin routes entirely. An unset secret must
# never mean "open to everyone" — that is how a review console leaks every
# flagged photo. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_ADMIN_TOKEN=
