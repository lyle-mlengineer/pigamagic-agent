# --- PlusOne agent configuration ---
# Copy to .env and fill in. This file holds NO real secrets.
# .env is gitignored; never commit real keys.

# Provider selection (fixture adapters need no credentials)
# Image providers:
#   fixture      offline synthetic PNGs, free
#   nvidia       Black Forest Labs via NVIDIA NIM (needs AGENT_NVIDIA_API_KEY)
#   huggingface  local diffusers on your own GPU, free (Colab-friendly)
#   qwen         alias for huggingface + Qwen/Qwen-Image-Edit-2509 (identity!)
#   gemini | openai | fal
# Aliases: google, flux, hf, local, colab, flux-local, sd, nim, bfl
AGENT_LLM_PROVIDER=fixture
AGENT_VISION_PROVIDER=fixture
AGENT_IMAGE_PROVIDER=fixture
AGENT_WEB_PROVIDER=fixture

# Credentials (leave blank while using fixtures)
AGENT_LLM_API_KEY=
AGENT_VISION_API_KEY=
AGENT_IMAGE_API_KEY=
AGENT_WEB_API_KEY=

# Model identifiers (blank = the provider's pinned current default)
# gemini      -> gemini-3.1-flash-image
# openai      -> gpt-image-2.5-flare
# fal         -> blackforestlabs/flux-3/text-to-image
# nvidia      -> flux.3-image-klein
# huggingface -> black-forest-labs/FLUX.1-schnell  (ungated, free)
#   identity-preserving local options:
#     Qwen/Qwen-Image-Edit-2509        keeps facial identity, up to 3 refs
#     black-forest-labs/FLUX.1-Kontext-dev   gated, needs an HF token
AGENT_LLM_MODEL=
AGENT_VISION_MODEL=
AGENT_IMAGE_MODEL=

# Prompt versioning. Bumping this deliberately invalidates the prompt cache.
AGENT_PROMPT_VERSION=v1

# Budgets and limits
AGENT_MAX_SHOTS=16
AGENT_MAX_SEARCH_CALLS=6
AGENT_MAX_REFERENCE_NOTES_TOKENS=300
AGENT_IDENTITY_SIMILARITY_FLOOR=0.45
AGENT_IDENTITY_SIMILARITY_TARGET=0.62

# Real-spend ceiling for image generation, in USD. 0 = unlimited (fixtures only).
# A positive value makes the budget ledger REFUSE any call that would exceed it.
AGENT_IMAGE_BUDGET_USD=0

# Outbound provider reliability
AGENT_PROVIDER_MAX_ATTEMPTS=3
AGENT_PROVIDER_TIMEOUT_S=120

# Set to 1 to forbid ALL outbound HTTP. Tests and CI must stay offline.
AGENT_OFFLINE=false

# --- NVIDIA NIM (Black Forest Labs) -------------------------------------
# Get a key at https://build.nvidia.com  ->  your profile -> API Keys.
# Either this or AGENT_IMAGE_API_KEY works; this one wins if both are blank
# elsewhere. Only needed when AGENT_IMAGE_PROVIDER=nvidia.
AGENT_NVIDIA_API_KEY=
# Optional override; defaults to the hosted endpoint.
AGENT_NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs
# Set true ONLY when pointing at your own NIM container. The hosted preview
# accepts only predefined example images, so it cannot preserve a real face.
AGENT_NVIDIA_NIM_SELF_HOSTED=false

# Storage
# local | s3 | backblaze  (s3 and backblaze share every setting below)
AGENT_STORAGE_PROVIDER=local
AGENT_MEDIA_DIR=./var/media
# Optional: prefix URLs for the local store, e.g. http://localhost:8000/media
AGENT_MEDIA_BASE_URL=

# S3-compatible object storage.
# Backblaze B2: set AGENT_STORAGE_PROVIDER=backblaze, put the bucket's region
# (e.g. us-west-004) in AGENT_STORAGE_REGION, use the APPLICATION KEY ID as the
# access key id and the APPLICATION KEY as the secret. The B2 master key does
# not work with the S3 API. Leave AGENT_STORAGE_ENDPOINT blank and the endpoint
# is derived as https://s3.<region>.backblazeb2.com.
# Cloudflare R2 / MinIO / Wasabi: set AGENT_STORAGE_PROVIDER=s3 and fill in
# AGENT_STORAGE_ENDPOINT yourself.
AGENT_STORAGE_BUCKET=
AGENT_STORAGE_ENDPOINT=
AGENT_STORAGE_REGION=
AGENT_STORAGE_ACCESS_KEY_ID=
AGENT_STORAGE_SECRET_ACCESS_KEY=
# Key prefix inside the bucket, so several apps can share one bucket.
AGENT_STORAGE_PREFIX=plusone
# Public/CDN base for read URLs. Blank serves through the app.
AGENT_STORAGE_PUBLIC_BASE_URL=

# --- Admin surface -----------------------------------------------------------
# Shared secret for /api/v1/admin/* (safety review console, account purge).
# Sent as the `X-Admin-Token` header.
#
# Leave this BLANK to disable the admin routes entirely. An unset secret must
# never mean "open to everyone" — that is how a review console leaks every
# flagged photo. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_ADMIN_TOKEN=
